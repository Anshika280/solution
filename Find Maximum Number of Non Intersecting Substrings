import java.util.Arrays;

class Solution {
    public int maxSubstrings(String word) {
        int[] first = new int[26];
        Arrays.fill(first, -1);

        int ans = 0;
        int lastEnd = -1;

        for (int i = 0; i < word.length(); i++) {
            int c = word.charAt(i) - 'a';

            // This occurrence must be after the previous chosen substring
            if (first[c] <= lastEnd) {
                first[c] = i;
            }

            // Substring length must be at least 4
            if (i - first[c] + 1 >= 4) {
                ans++;
                lastEnd = i;

                // This character cannot be reused as a starting point
                first[c] = -1;
            }
        }

        return ans;
    }
}
